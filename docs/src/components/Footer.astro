---
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="wordmark">Loft</span>
      <span class="company">Felobo B.V. &copy; {year}</span>
    </div>
    <nav class="footer-links" aria-label="Footer links">
      <a href="mailto:rene@weteling.com">rene@weteling.com</a>
      <a href="https://github.com/reneweteling" target="_blank" rel="noopener">
        github.com/reneweteling
      </a>
      <a href="https://weteling.com" target="_blank" rel="noopener">
        weteling.com
      </a>
    </nav>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: 0;
  }

  .footer-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 3.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 3rem;
    align-items: center;
    justify-content: space-between;
  }

  .footer-brand {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .wordmark {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .company {
    font-size: 0.83rem;
    color: var(--text-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    align-items: center;
  }

  .footer-links a {
    font-size: 0.83rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-links a:hover {
    color: var(--teal);
  }

  @media (max-width: 560px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
