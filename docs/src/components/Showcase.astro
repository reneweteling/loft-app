---
const base = import.meta.env.BASE_URL;
const shots = [
  { src: `${base}assets/ex-settings-general.png`, label: 'General' },
  { src: `${base}assets/ex-settings-panes.png`, label: 'Panes' },
  { src: `${base}assets/ex-settings-s3.png`, label: 'S3' },
  { src: `${base}assets/ex-settings-about.png`, label: 'About' },
];
---

<section class="showcase">
  <div class="inner">
    <header>
      <span class="eyebrow">See it in motion</span>
      <h2>One drag from your desktop to a link.</h2>
      <p>A six-second demo, then the full Settings tour.</p>
    </header>

    <figure class="video-wrap">
      <video
        src={`${base}assets/ex-upload.mp4`}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={`${base}assets/ex-menu-open.png`}
      ></video>
    </figure>

    <figure class="hero-shot">
      <img src={`${base}assets/ex-menu-open.png`} alt="Loft popover with the four drop panes" loading="lazy" />
      <figcaption>The popover. Four panes, each with a different TTL.</figcaption>
    </figure>

    <div class="grid">
      {shots.map((s) => (
        <figure>
          <img src={s.src} alt={`Settings — ${s.label}`} loading="lazy" />
          <figcaption>{s.label}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .showcase {
    padding: clamp(3.5rem, 8vw, 6rem) 1.25rem;
    background: linear-gradient(180deg, rgba(14, 165, 233, 0.04) 0%, transparent 100%);
  }
  .inner {
    max-width: 1040px;
    margin: 0 auto;
  }
  header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #0EA5E9;
    margin-bottom: 0.6rem;
  }
  h2 {
    font-size: clamp(1.75rem, 3.2vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
    color: var(--fg, #f4f6fb);
  }
  header p {
    color: var(--fg-dim, #9aa4b8);
    margin: 0;
    font-size: 1rem;
  }

  .video-wrap {
    margin: 0 0 2.5rem;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #0b1020;
    box-shadow:
      0 40px 80px -30px rgba(0, 0, 0, 0.7),
      0 10px 30px -10px rgba(14, 165, 233, 0.3);
  }
  .video-wrap video {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-shot {
    margin: 0 auto 2.5rem;
    max-width: 640px;
    text-align: center;
  }
  .hero-shot img {
    width: 100%;
    height: auto;
    border-radius: 14px;
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.6);
  }
  .hero-shot figcaption,
  .grid figcaption {
    margin-top: 0.6rem;
    color: var(--fg-dim, #9aa4b8);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .grid figure {
    margin: 0;
    text-align: center;
  }
  .grid img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .grid img:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px -18px rgba(14, 165, 233, 0.55);
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
