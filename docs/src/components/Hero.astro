---
const downloadUrl = 'https://github.com/reneweteling/loft-app/releases/latest';
const githubUrl = 'https://github.com/reneweteling/loft-app';
---

<header class="hero grain">
  <!-- Radial light bloom -->
  <div class="bloom" aria-hidden="true"></div>

  <!-- Diagonal accent band -->
  <div class="band" aria-hidden="true"></div>

  <div class="hero-content">
    <div class="eyebrow">macOS menu bar uploader</div>
    <h1 class="wordmark">Loft</h1>
    <p class="tagline">
      Drag a file to your menu bar.<br />Get a link back.
    </p>

    <div class="cta-row">
      <a class="btn-primary" href={downloadUrl}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 2v8m0 0L5 7m3 3 3-3M2 13h12" stroke="currentColor" stroke-width="1.8"
            stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Download for macOS
      </a>
      <a class="btn-ghost" href={githubUrl} target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
            0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52
            -.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07
            -1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12
            0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82
            2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65
            3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013
            8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
        </svg>
        View on GitHub
      </a>
    </div>

    <p class="platform-note">macOS 14+ &nbsp;·&nbsp; Apple Silicon &amp; Intel &nbsp;·&nbsp; Free &amp; open source</p>
  </div>

  <div class="scroll-hint" aria-hidden="true">
    <span>Scroll</span>
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
      <path d="M2 4l5 5 5-5" stroke="currentColor" stroke-width="1.75"
        stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</header>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 1.5rem 7rem;
    background: linear-gradient(145deg, #0c2a6e 0%, #1a4dab 30%, #0EA5E9 70%, #38bdf8 100%);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .bloom {
    position: absolute;
    top: -10%;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 60%;
    background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.1) 0%, transparent 65%);
    pointer-events: none;
  }

  /* Diagonal accent — gives it an asymmetric punch */
  .band {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      transparent 0%,
      transparent 42%,
      rgba(255, 255, 255, 0.04) 42%,
      rgba(255, 255, 255, 0.04) 58%,
      transparent 58%
    );
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 1rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.35rem 1rem;
    border-radius: 999px;
    backdrop-filter: blur(8px);
  }

  .wordmark {
    font-size: clamp(5rem, 15vw, 9rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    color: #fff;
    line-height: 0.9;
    margin-bottom: 1.25rem;
    /* Subtle text shadow for depth */
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.25);
  }

  .tagline {
    font-size: clamp(1.05rem, 2.8vw, 1.45rem);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.82);
    max-width: 440px;
    margin-bottom: 2.75rem;
    line-height: 1.5;
  }

  .cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .platform-note {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.48);
    letter-spacing: 0.02em;
  }

  .scroll-hint {
    position: absolute;
    bottom: 2.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    color: rgba(255, 255, 255, 0.35);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    z-index: 1;
  }

  .scroll-hint svg {
    animation: bounce 2s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(5px); }
  }

  @media (max-width: 480px) {
    .cta-row {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
